{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "redirects": [{ "source": "/lab", "destination": "/lab/", "permanent": true }],
  "headers": [
    { "source": "/lab/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/lab/(models|draco)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/ar/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    {
      "source": "/lab/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://cdn.jsdelivr.net; worker-src 'self' blob:" },
        { "key": "Permissions-Policy", "value": "xr-spatial-tracking=(self)" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
